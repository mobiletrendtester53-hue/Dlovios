local prePortalPosition = Vector3.new(7.515656471252441, 14.683902740478516, -78.0965576171875)
local descentPosition = Vector3.new(-1836.67, 84.76, -10974.69)
local shopPosition = Vector3.new(-1887.23, 60.26, -10523.55)

local function getBoss()
    return workspace:FindFirstChild("AlienBoss") or workspace:FindFirstChild("Boss") or workspace:FindFirstChild("Alien Boss")
end

local function getBossPosition()
    local boss = getBoss()
    if boss then
        local hrp = boss:FindFirstChild("HumanoidRootPart") or boss:FindFirstChild("Head") or boss:FindFirstChild("Torso")
        if hrp then
            return Vector3.new(hrp.Position.X, 150.17737007141113, hrp.Position.Z)
        end
    end
    return Vector3.new(-1836.6787109375, 150.17737007141113, -10974.6865234375)
end

