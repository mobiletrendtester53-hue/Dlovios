    local enteredHash = ""
    if identifyexecutor then
        pcall(function()
            if syn and syn.crypt then
                enteredHash = syn.crypt.hash(passwordBox.Text)
            elseif crypt and crypt.hash then
                enteredHash = crypt.hash(passwordBox.Text)
            end
        end)
    end
    
    if enteredHash == CORRECT_HASH or passwordBox.Text == "ImpDlovio" then
        passwordFrame:Destroy()
        mainFrame.Visible = true
    else
        passwordBox.Text = ""
        passwordBox.PlaceholderText = "Неверный пароль!"
        submitButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        task.wait(0.8)
        if submitButton and submitButton.Parent then
            submitButton.BackgroundColor3 = Color3.fromRGB(139, 0, 0)
            passwordBox.PlaceholderText = "Пароль..."
        end
    end
end)

local function ensurePunchEquipped()
    local character = LocalPlayer.Character
    if not character then return nil end

    local punch = character:FindFirstChild("Punch") or LocalPlayer.Backpack:FindFirstChild("Punch")
    if punch then
        if (punch.Parent ~= character) then
            punch.Parent = character
        end
        if punch:FindFirstChild("attackTime") then
            punch.attackTime.Value = 0
        end
        return punch
    end

    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if (tool.Name == "Punch") then
            tool.Parent = character
            if tool:FindFirstChild("attackTime") then
                tool.attackTime.Value = 0
            end
            return tool
        end
    end
    return nil
end

local function autoPunch()
    local character = LocalPlayer.Character
    if not character then return end

    local punch = ensurePunchEquipped()
    
    pcall(function()
        LocalPlayer.muscleEvent:FireServer("punch", "rightHand")
        LocalPlayer.muscleEvent:FireServer("punch", "leftHand")
    end)

    if (punch and (punch.Parent == character)) then
        pcall(function()
            punch:Activate()
        end)
    end
end

local function pullToBossHead()
    local character = LocalPlayer.Character
    if not character then return end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    humanoid.PlatformStand = true
    
    local targetPos = getBossPosition()
    hrp.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(-90), 0, 0)
    
    hrp.Velocity = Vector3.zero
    hrp.RotVelocity = Vector3.zero
end

local function travelToPortal()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        hrp.CFrame = CFrame.new(prePortalPosition)
        hrp.Velocity = Vector3.zero
    end
    task.wait(0.3)
    
    pcall(function()
        local args = {
            "travelToArea",
            workspace:WaitForChild("areaCircles"):WaitForChild("alienGymCircle")
        }
        ReplicatedStorage:WaitForChild("rEvents"):WaitForChild("areaTravelRemote"):InvokeServer(unpack(args))
    end)
    task.wait(1.5)
end

local function pressKeyE()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

local function sellPet(petInstance)
    if not autoSellEnabled then return end
    
    if petInstance:IsA("StringValue") and targetPets[petInstance.Name] then
        task.wait(0.1)
        if petInstance and petInstance.Parent then
            sellEvent:FireServer("sellPet", petInstance)
        end
    end
end

toggleBossButton.MouseButton1Click:Connect(function()
    autoBossEnabled = not autoBossEnabled
    
    if autoBossEnabled then
        toggleBossButton.Text = "Auto Boss: ON"
        toggleBossButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        task.spawn(function()
            travelToPortal()
            pullToBossHead()
            
            while autoBossEnabled do
                local character = LocalPlayer.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                
                local boss = getBoss()
                local bossHumanoid = boss and boss:FindFirstChildOfClass("Humanoid")
                
                local bossIsAlive = false
                if boss and bossHumanoid then
                    if bossHumanoid.Health > 0 then
                        bossIsAlive = true
                    end
                elseif boss and not bossHumanoid then
                    bossIsAlive = true
                end

                if bossIsAlive then
                    if character and humanoid and humanoid.Health > 0 then
                        pullToBossHead()
                        autoPunch()
                    end
                else
                    if character and character:FindFirstChild("HumanoidRootPart") then
                        local hrp = character.HumanoidRootPart
                        if humanoid then humanoid.PlatformStand = false end
                        hrp.CFrame = CFrame.new(descentPosition)
                        hrp.Velocity = Vector3.zero
                    end
                    
                    repeat
                        task.wait(1)
                        boss = getBoss()
                        bossHumanoid = boss and boss:FindFirstChildOfClass("Humanoid")
                    until not autoBossEnabled or (boss and (not bossHumanoid or bossHumanoid.Health > 0))
                    
                    if autoBossEnabled then
                        task.wait(1)
                        pullToBossHead()
                    end
                end
                
                task.wait(0.05)
            end
            
            local character = LocalPlayer.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid then humanoid.PlatformStand = false end
            end
        end)
    else
        toggleBossButton.Text = "Auto Boss: OFF"
        toggleBossButton.BackgroundColor3 = Color3.fromRGB(139, 0, 0)
        
        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then humanoid.PlatformStand = false end
        end
    end
end)

toggleCollectButton.MouseButton1Click:Connect(function()
    autoCollectEnabled = not autoCollectEnabled
    
    if autoCollectEnabled then
        toggleCollectButton.Text = "Auto Collect: ON"
        toggleCollectButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        task.spawn(function()
            while autoCollectEnabled do
                local function waitForBossDead()
                    while autoCollectEnabled do
                        local boss = getBoss()
                        local bossHumanoid = boss and boss:FindFirstChildOfClass("Humanoid")
                        if not boss or (bossHumanoid and bossHumanoid.Health <= 0) then
                            return true
                        end
                        task.wait(1)
                    end
                    return false
                end

                if not waitForBossDead() then break end

                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local hrp = character.HumanoidRootPart
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    if humanoid then humanoid.PlatformStand = false end
                    hrp.CFrame = CFrame.new(descentPosition)
                    hrp.Velocity = Vector3.zero
                end
                task.wait(0.5)

                pressKeyE()
                task.wait(0.4)

                if character and character:FindFirstChild("HumanoidRootPart") then
                    character.HumanoidRootPart.CFrame = CFrame.new(shopPosition)
                    character.HumanoidRootPart.Velocity = Vector3.zero
                end
                task.wait(1)

                while autoCollectEnabled do
                    local boss = getBoss()
                    local bossHumanoid = boss and boss:FindFirstChildOfClass("Humanoid")
                    if boss and (not bossHumanoid or bossHumanoid.Health > 0) then
                        break
                    end
                    task.wait(1)
                end
            end
        end)
    else
        toggleCollectButton.Text = "Auto Collect: OFF"
        toggleCollectButton.BackgroundColor3 = Color3.fromRGB(139, 0, 0)
    end
end)

toggleSellButton.MouseButton1Click:Connect(function()
    autoSellEnabled = not autoSellEnabled
    
    if autoSellEnabled then
        toggleSellButton.Text = "Auto Sell Pets: ON"
        toggleSellButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        task.spawn(function()
            for _, item in ipairs(petsFolder:GetDescendants()) do
                if not autoSellEnabled then break end
                task.spawn(sellPet, item)
            end
        end)
    else
        toggleSellButton.Text = "Auto Sell Pets: OFF"
        toggleSellButton.BackgroundColor3 = Color3.fromRGB(139, 0, 0)
    end
end)

toggleBuyButton.MouseButton1Click:Connect(function()
    autoBuyEnabled = not autoBuyEnabled
    
    if autoBuyEnabled then
        toggleBuyButton.Text = "Buy Pet: ON"
        toggleBuyButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        
        task.spawn(function()
            while autoBuyEnabled do
                local function waitForBossDead()
                    while autoBuyEnabled do
                        local boss = getBoss()
                        local bossHumanoid = boss and boss:FindFirstChildOfClass("Humanoid")
                        if not boss or (bossHumanoid and bossHumanoid.Health <= 0) then
                            return true
                        end
                        task.wait(1)
                    end
                    return false
                end

                if not waitForBossDead() then break end

                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local hrp = character.HumanoidRootPart
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    if humanoid then humanoid.PlatformStand = false end
                    hrp.CFrame = CFrame.new(descentPosition)
                    hrp.Velocity = Vector3.zero
                end
                task.wait(0.5)

                pressKeyE()
                task.wait(0.4)

                if character and character:FindFirstChild("HumanoidRootPart") then
                    character.HumanoidRootPart.CFrame = CFrame.new(shopPosition)
                    character.HumanoidRootPart.Velocity = Vector3.zero
                end
                task.wait(0.5)

                pressKeyE()
                task.wait(0.5)

                local function getShopBoss()
                    local boss = getBoss()
                    local bossHumanoid = boss and boss:FindFirstChildOfClass("Humanoid")
                    return boss and (not bossHumanoid or bossHumanoid.Health > 0)
                end

                while autoBuyEnabled and not getShopBoss() do
                    pcall(function()
                        script_args = {
                            "UFOAxolotl"
                        }
                        ReplicatedStorage:WaitForChild("packages"):WaitForChild("Net"):WaitForChild("RF/AlienShop"):InvokeServer(unpack(script_args))
  end)
                    task.wait(1)
                end
            end
        end)
    else
        toggleBuyButton.Text = "Buy Pet: OFF"
        toggleBuyButton.BackgroundColor3 = Color3.fromRGB(139, 0, 0)
    end
end)

petsFolder.DescendantAdded:Connect(function(newItem)
    if autoSellEnabled then
        sellPet(newItem)
    end
end)
